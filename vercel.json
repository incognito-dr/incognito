{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.{jpg,png,svg}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/oasis1800/?$",
      "dest": "/oasis1800.html"
    },
    {
      "src": "^/confirmar/?$",
      "dest": "/confirmar.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
